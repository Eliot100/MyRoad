.git
.github
.env
.env.*
!.env.example
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
# Local clutter
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/*.egg-info
