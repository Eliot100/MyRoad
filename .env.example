# Server environment only. Leave values empty in git.
# Do not put an xAI provider key in this file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
# /tools/* agent credential (Bearer). Empty = agent API access disabled. Min 16 chars.
MYROAD_AGENT_TOKEN=
# Actor id recorded for calls made with MYROAD_AGENT_TOKEN (default agent_service).
MYROAD_AGENT_ID=
# Email sign-in codes. Empty MYROAD_SMTP_HOST = codes are printed to the server console (local/demo).
MYROAD_SMTP_HOST=
MYROAD_SMTP_PORT=
MYROAD_SMTP_USER=
MYROAD_SMTP_PASSWORD=
MYROAD_SMTP_STARTTLS=
MYROAD_MAIL_FROM=
